rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── App error log (server / Admin SDK only) ────────────────────────────
    match /error_logs/{id} {
      allow read, write: if false;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    function isAdminOrMod() {
      return isSignedIn() && callerRole() in ['admin', 'moderator'];
    }

    // Fields that only admins/moderators may change on a user document.
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'userStatus', 'kickoffInPersonAdminConfirmed',
                      'accountDisabled', 'accountDisabledReason',
                      'programOptOut', 'programOptOutAt']);
    }

    /** Maintained only by Admin SDK (DevcampBuddies APIs) — not client-patchable. */
    function touchesServerMaintainedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'buddyCount',
        'certifierCredentialId',
        'certifierCredentialPublicId',
        'certifierCredentialStatus',
        'certifierSyncedAt'
      ]);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Archived profiles (server / Admin SDK only — no client access).
    match /disabledUsers/{uid} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Any signed-in user can read their own doc; admins/mods can read all.
      allow read: if isSignedIn() && (isOwner(userId) || isAdminOrMod());

      // New account creation — owner only, cannot pre-set privileged fields.
      allow create: if isSignedIn() && isOwner(userId)
                    && !('role' in request.resource.data
                         ? request.resource.data.role != 'attendee'
                         : false)
                    && request.resource.data.userStatus in ['pending', 'participated'];

      // Self-updates: allowed, UNLESS they touch role or userStatus or server-only fields.
      // Admins/mods may update anything.
      allow update: if isSignedIn() && (
        (isOwner(userId) && !touchesPrivilegedFields() && !touchesServerMaintainedUserFields()) ||
        isAdminOrMod()
      );

      allow delete: if isAdmin();
    }

    // ── Tag catalog (dropdowns: Prior AI Knowledge, skills, etc.) ─────────────
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Speakers / mentors roster ─────────────────────────────────────────────
    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    // ── Sessions ──────────────────────────────────────────────────────────────
    // Public read; only admins/mods may write.
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    // Live self check-in config (6-digit code + window). Not public — attendees validate via API only.
    match /session_self_checkin/{sessionId} {
      allow read, write: if isAdminOrMod();
    }

    // ── Attendance ────────────────────────────────────────────────────────────
    match /attendance/{userId} {
      // Owner can read their own record; admins/mods can read all.
      allow read: if isSignedIn() && (isOwner(userId) || isAdminOrMod());
      // Only admins/mods may mark attendance.
      allow write: if isAdminOrMod();
    }

    // ── Assignments ───────────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdminOrMod()
      );

      // Create: must own the submission, userId must match.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Update: owner may update content fields but cannot change userId or status.
      // Admins/mods may update anything (e.g. change status, add feedback).
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'userId'])
        ) ||
        isAdminOrMod()
      );

      allow delete: if isAdmin();
    }

    // ── Projects ──────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      // Owner or admins/mods only — do not expose submitter email via world-readable queries.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdminOrMod()
      );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'userId'])
        ) ||
        isAdminOrMod()
      );

      allow delete: if isAdmin();
    }

    // ── Learning tasks (private per user) ────────────────────────────────────
    match /learningTasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Learning task templates (organiser catalogue) ────────────────────────
    match /learningTaskTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMod();
    }

    // ── Activity telemetry (views, resource clicks) — server / Admin SDK only ─
    match /activity_events/{eventId} {
      allow read, write: if false;
    }

    // ── DevcampBuddies (buddyRequests, buddyPairs) — Admin SDK / API only ────
    match /buddyRequests/{requestId} {
      allow read, write: if false;
    }
    match /buddyPairs/{pairId} {
      allow read, write: if false;
    }

    // ── Cohorts — read/written only via /api/cohorts (Admin SDK). No client access. ──
    match /cohorts/{cohortId} {
      allow read, write: if false;
    }

    // ── Speaker call submissions — written by /api/speaker-call (Admin SDK). ──
    // Public form input; never client-readable (contains submitter email).
    match /speakerCallSubmissions/{document=**} {
      allow read, write: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // Any collection not matched above is server-only (Admin SDK) by default.
    // Explicit catch-all documents intent; add a specific match before granting
    // any client access to a new collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
