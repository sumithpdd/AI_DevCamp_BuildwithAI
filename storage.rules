rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar uploads: owner may read/write their own file; anyone can read.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // 5 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Speaker roster photos — written only by the Admin SDK
    // (scripts/upload-speaker-photos.ts). Served to clients via signed download
    // tokens (getDownloadURL-style URLs), which bypass these rules, so no direct
    // client read/write is granted here.
    match /speakers/{allPaths=**} {
      allow read, write: if false;
    }

    // Call-for-speakers photo uploads — written only by the Admin SDK
    // (/api/speaker-call/upload-photo, which validates type + size server-side).
    // Private; served to organisers via download token only.
    match /speaker-submissions/{allPaths=**} {
      allow read, write: if false;
    }

    // All other paths: deny by default (server-only via Admin SDK).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
