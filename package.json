{
  "name": "ai-devcamp-buildwithai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ensure-profiles": "tsx --env-file=.env.local scripts/ensure-profiles.ts",
    "backfill-registration-map-coords": "tsx --env-file=.env.local scripts/backfill-registration-map-coords.ts",
    "generate-favicons": "tsx scripts/generate-favicons.ts",
    "sync-firestore-programme": "tsx --env-file=.env.local scripts/sync-firestore-programme.ts",
    "upload-speaker-photos": "tsx --env-file=.env.local scripts/upload-speaker-photos.ts",
    "delete-legacy-speaker-docs": "tsx --env-file=.env.local scripts/delete-legacy-speaker-docs.ts",
    "migrate-to-cohorts": "tsx --env-file=.env.local scripts/migrate-to-cohorts.ts",
    "migrate:june:dry": "cross-env COHORT_ID=cohort-june-2026 DRY_RUN=true npm run migrate-to-cohorts",
    "migrate:june:confirm": "cross-env COHORT_ID=cohort-june-2026 CONFIRM=true npm run migrate-to-cohorts",
    "migrate:sept:dry": "cross-env COHORT_ID=cohort-september-2026 DRY_RUN=true npm run migrate-to-cohorts",
    "migrate:sept:confirm": "cross-env COHORT_ID=cohort-september-2026 CONFIRM=true npm run migrate-to-cohorts",
    "seed-cohorts": "tsx --env-file=.env.local scripts/seed-cohorts.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "nodemailer": "^8.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
